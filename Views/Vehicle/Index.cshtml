@model SearchFilterViewModel
@{
    ViewData["Title"] = "Explore Luxury & Sports Fleet";
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small text-muted mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-dim">Home</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Vehicles</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold text-white mb-0">Our Fleet Portfolio</h1>
        </div>
        <div class="badge bg-primary text-white py-2 px-3 rounded-pill fs-6 d-inline-flex align-items-center gap-2">
            <i class="bi bi-car-front-fill"></i> @Model.Vehicles.Count Vehicles Found
        </div>
    </div>

    <!-- Filter & Search Controls Bar -->
    <div class="p-4 rounded-4 mb-4" style="background: var(--bg-surface); border: 1px solid var(--border);">
        <form asp-controller="Vehicle" asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label text-muted small fw-bold"><i class="bi bi-search me-1"></i> Search Model / Make</label>
                    <input type="text" name="query" class="form-control input-custom" placeholder="e.g. Porsche, Tesla, AMG..." value="@Model.Query" />
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <label class="form-label text-muted small fw-bold">Category</label>
                    <select name="category" class="form-select input-custom">
                        <option value="All" selected="@(Model.Category == "All")">All Categories</option>
                        <option value="Sports" selected="@(Model.Category == "Sports")">Sports</option>
                        <option value="Luxury" selected="@(Model.Category == "Luxury")">Luxury</option>
                        <option value="SUV" selected="@(Model.Category == "SUV")">SUV</option>
                        <option value="Electric" selected="@(Model.Category == "Electric")">Electric</option>
                        <option value="Sedan" selected="@(Model.Category == "Sedan")">Sedan</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <label class="form-label text-muted small fw-bold">Fuel Type</label>
                    <select name="fuelType" class="form-select input-custom">
                        <option value="All" selected="@(Model.FuelType == "All")">All Fuels</option>
                        <option value="Electric" selected="@(Model.FuelType == "Electric")">Electric</option>
                        <option value="Petrol" selected="@(Model.FuelType == "Petrol")">Petrol</option>
                        <option value="Hybrid" selected="@(Model.FuelType == "Hybrid")">Hybrid</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <label class="form-label text-muted small fw-bold">Transmission</label>
                    <select name="transmission" class="form-select input-custom">
                        <option value="All" selected="@(Model.Transmission == "All")">All Transmissions</option>
                        <option value="Automatic" selected="@(Model.Transmission == "Automatic")">Automatic</option>
                        <option value="Manual" selected="@(Model.Transmission == "Manual")">Manual</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <label class="form-label text-muted small fw-bold">Sort By</label>
                    <select name="sortBy" class="form-select input-custom">
                        <option value="rating" selected="@(Model.SortBy == "rating")">Top Rated</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                        <option value="year" selected="@(Model.SortBy == "year")">Newest Year</option>
                    </select>
                </div>

                <div class="col-lg-1 col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-luxury-primary w-100 py-2" title="Apply Filters">
                        <i class="bi bi-funnel-fill"></i>
                    </button>
                    <a asp-action="Index" class="btn btn-luxury-outline py-2" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Vehicle Grid -->
    @if (Model.Vehicles.Any())
    {
        <div class="row g-4">
            @foreach (var car in Model.Vehicles)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="vehicle-card">
                        <div class="vehicle-img-wrapper">
                            <img src="@car.ImageUrl" alt="@car.FullName" class="vehicle-img" />
                            <span class="badge-category">@car.Category</span>
                            <span class="badge-availability @(car.IsAvailable ? "badge-available" : "badge-booked")">
                                <i class="bi @(car.IsAvailable ? "bi-check-circle-fill" : "bi-clock-history") me-1"></i>
                                @(car.IsAvailable ? "Available" : "Reserved")
                            </span>
                        </div>

                        <div class="vehicle-content">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="vehicle-make">@car.Make &bull; @car.Year</span>
                                <div class="small text-warning">
                                    <i class="bi bi-star-fill"></i> @car.Rating <span class="text-dim">(@car.ReviewCount)</span>
                                </div>
                            </div>

                            <h3 class="vehicle-name">@car.Model</h3>
                            <p class="text-muted small text-truncate-2 mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px;">
                                @car.Description
                            </p>

                            <!-- Specs -->
                            <div class="specs-grid">
                                <div class="spec-item">
                                    <i class="bi bi-fuel-pump spec-icon"></i>
                                    <span class="spec-label">Fuel</span>
                                    <span class="spec-val">@car.FuelType</span>
                                </div>
                                <div class="spec-item">
                                    <i class="bi bi-gear-wide-connected spec-icon"></i>
                                    <span class="spec-label">Trans</span>
                                    <span class="spec-val">@car.Transmission</span>
                                </div>
                                <div class="spec-item">
                                    <i class="bi bi-people spec-icon"></i>
                                    <span class="spec-label">Seats</span>
                                    <span class="spec-val">@car.Seats Seats</span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between mt-auto pt-2">
                                <div class="price-tag">
                                    <span class="price-currency">₹</span>
                                    <span class="price-amount">@car.DailyRate.ToString("N0")</span>
                                    <span class="price-period">/ day</span>
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-luxury-outline py-2 px-3 small" title="View Specifications">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                    @if (car.IsAvailable)
                                    {
                                        <a asp-controller="Booking" asp-action="Create" asp-route-vehicleId="@car.Id" class="btn btn-luxury-primary py-2 px-3 small">
                                            Book <i class="bi bi-chevron-right ms-1"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary py-2 px-3 small" disabled style="opacity: 0.6;">
                                            Reserved
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-5 text-center rounded-4 my-5" style="background: var(--bg-surface); border: 1px dashed var(--border);">
            <i class="bi bi-search fs-1 text-dim mb-3 d-block"></i>
            <h4 class="text-white fw-bold">No vehicles matched your search criteria</h4>
            <p class="text-muted small mb-4">Try clearing some of your filters or searching for another vehicle make.</p>
            <a asp-action="Index" class="btn btn-luxury-primary">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset All Filters
            </a>
        </div>
    }
</div>
