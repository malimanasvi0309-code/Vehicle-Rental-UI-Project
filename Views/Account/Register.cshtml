@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account - EliteDrive";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="p-4 p-sm-5 rounded-4 shadow-lg" style="background: var(--bg-surface); border: 1px solid var(--border);">
                <div class="text-center mb-4">
                    <div class="brand-icon mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.25rem;">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h2 class="h3 fw-bold text-white mb-1">Join EliteDrive</h2>
                    <p class="text-muted small">Access exclusive supercars, contactless delivery, and member pricing</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">Full Legal Name</label>
                            <input asp-for="FullName" class="form-control input-custom" placeholder="e.g. Jordan Hayes" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control input-custom" placeholder="you@domain.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Mobile Phone</label>
                            <input asp-for="Phone" type="tel" class="form-control input-custom" placeholder="+1 (555) 000-0000" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">Driver License Number</label>
                            <input asp-for="DriverLicenseNumber" class="form-control input-custom" placeholder="e.g. DL-CA-948201" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Create Password</label>
                            <input asp-for="Password" type="password" class="form-control input-custom" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control input-custom" required />
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="termsCheck" required checked />
                        <label class="form-check-label text-muted small" for="termsCheck">
                            I agree to the <a asp-controller="Home" asp-action="Privacy" class="text-primary">Rental Agreement & Privacy Policy</a>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-luxury-primary w-100 py-2 fs-6 mb-3">
                        Complete Registration <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <div class="text-center small text-muted">
                        Already have an account? 
                        <a asp-action="Login" class="text-primary fw-bold">Sign In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
