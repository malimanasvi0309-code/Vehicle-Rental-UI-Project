@model Vehicle
@{
    ViewData["Title"] = "Add Vehicle to Fleet - Admin Portal";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small text-muted">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-dim">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Vehicles" class="text-dim">Fleet Management</a></li>
            <li class="breadcrumb-item active text-white" aria-current="page">Add New Vehicle</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="p-4 p-md-5 rounded-4 shadow-lg" style="background: var(--bg-surface); border: 1px solid var(--border);">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom" style="border-color: var(--border) !important;">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: rgba(79, 70, 229, 0.2); color: #818cf8;">
                        <i class="bi bi-car-front-fill fs-4"></i>
                    </div>
                    <div>
                        <h2 class="h3 fw-bold text-white mb-0">Register New Vehicle</h2>
                        <p class="text-muted small mb-0">Add a new supercar, luxury sedan, or SUV into the active rental inventory</p>
                    </div>
                </div>

                <form asp-action="AddVehicle" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                    <!-- Row 1: Make & Model -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Manufacturer / Make</label>
                            <input asp-for="Make" class="form-control input-custom" placeholder="e.g. Ferrari, McLaren, Aston Martin" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Model Designation</label>
                            <input asp-for="Model" class="form-control input-custom" placeholder="e.g. 296 GTB, 720S, DB12" required />
                        </div>
                    </div>

                    <!-- Row 2: Category, Year, Rate -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">Fleet Category</label>
                            <select asp-for="Category" class="form-select input-custom">
                                <option value="Sports">Sports & Supercars</option>
                                <option value="Luxury">Ultra Luxury</option>
                                <option value="SUV">Executive SUV</option>
                                <option value="Electric">Electric / Hybrid</option>
                                <option value="Sedan">Executive Sedan</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">Model Year</label>
                            <input asp-for="Year" type="number" class="form-control input-custom" min="2020" max="2027" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">Daily Rental Rate (₹ INR)</label>
                            <input asp-for="DailyRate" type="number" step="100" class="form-control input-custom" min="1000" max="200000" required />
                        </div>
                    </div>

                    <!-- Row 3: Specs -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">Fuel Type</label>
                            <select asp-for="FuelType" class="form-select input-custom">
                                <option value="Petrol">Petrol</option>
                                <option value="Electric">Electric</option>
                                <option value="Hybrid">Hybrid</option>
                                <option value="Diesel">Diesel</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">Transmission</label>
                            <select asp-for="Transmission" class="form-select input-custom">
                                <option value="Automatic">Automatic (Dual-Clutch / PDK)</option>
                                <option value="Manual">Manual 6-Speed</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">Passenger Seats</label>
                            <input asp-for="Seats" type="number" class="form-control input-custom" min="2" max="9" required />
                        </div>
                    </div>

                    <!-- Row 4: Plate, Color, Image URL -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">License Plate Number</label>
                            <input asp-for="LicensePlate" class="form-control input-custom" placeholder="e.g. FER-296-X" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">Exterior Color</label>
                            <input asp-for="Color" class="form-control input-custom" placeholder="e.g. Rosso Corsa" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">Availability Status</label>
                            <select asp-for="IsAvailable" class="form-select input-custom">
                                <option value="true">Available Immediately</option>
                                <option value="false">Reserved / Maintenance</option>
                            </select>
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">High-Resolution Image URL</label>
                        <input asp-for="ImageUrl" class="form-control input-custom" placeholder="https://images.unsplash.com/..." />
                        <small class="text-dim">Leave blank to use default curated luxury supercar photography</small>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Detailed Vehicle Description & Highlights</label>
                        <textarea asp-for="Description" rows="3" class="form-control input-custom" placeholder="Describe the engine, driving dynamics, cabin comfort, and performance attributes..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: var(--border) !important;">
                        <a asp-action="Vehicles" class="btn btn-luxury-outline py-2 px-4">Cancel</a>
                        <button type="submit" class="btn btn-luxury-primary py-2 px-4 fs-6">
                            <i class="bi bi-check-lg me-1"></i> Add Vehicle to Fleet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
